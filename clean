#!/usr/bin/env bash
# ./clean — remove generated outputs and caches so you can start fresh.
#
# Removes (always):
#   cache/                  narration WAVs, image cache, remotion bundle
#   novels/<id>/output/     final MP4s, SRTs, chapter markers
#   novels/<id>/_work/      intermediate raw renders
#   remotion/public/        materialized asset mirrors (regen on next render)
#
# Preserves (expensive to recreate):
#   models/                 SDXL Turbo + diffusers weights (~6.5 GB)
#   .venv/                  Python venv
#   node_modules/           npm install
#   library/                user-curated reusable assets (music, logo, etc.)
#   in/                     your JSON spec(s)
#   manuscripts/, voices/, intro/, music/, cover/   your content
#
# Optional flags:
#   --library     also wipe library/visuals/backgrounds/*.png   (promoted images)
#   --models      also wipe models/                              (~6.5 GB redownload)
#   --all         shorthand for --library --models
#   --yes, -y     skip confirmation prompt
#   -h, --help    show this help
#
# Usage:
#   ./clean                  # standard clean — keeps SDXL weights + library
#   ./clean --library        # also drop promoted backgrounds
#   ./clean --all --yes      # nuclear reset, no prompt
# ----------------------------------------------------------------------------
set -euo pipefail
cd "$(dirname "$0")"

say()  { printf "\033[1;36m==>\033[0m %s\n" "$*" >&2; }
warn() { printf "\033[1;33m!\033[0m %s\n"   "$*" >&2; }
die()  { printf "\033[1;31mERROR:\033[0m %s\n" "$*" >&2; exit 1; }

LIBRARY=false
MODELS=false
YES=false

for arg in "$@"; do
  case "$arg" in
    --library)   LIBRARY=true ;;
    --models)    MODELS=true ;;
    --all)       LIBRARY=true; MODELS=true ;;
    --yes|-y)    YES=true ;;
    -h|--help)
      # Print the header comment block: skip shebang, stop at the first non-# line.
      awk '/^#!/{next} !/^#/{exit} {sub(/^# ?/,""); print}' "$0"
      exit 0 ;;
    *) die "unknown flag: $arg" ;;
  esac
done

# ── 1. Detect in-flight render and offer to kill ────────────────────────────
running=$(pgrep -f 'scripts/render.mjs' 2>/dev/null || true)
if [[ -n "${running:-}" ]]; then
  warn "a render is currently in progress (pid: $running)"
  if [[ "$YES" = false ]]; then
    read -rp "Kill it and proceed with clean? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { say "aborted; render still running"; exit 1; }
  fi
  # SIGTERM first (graceful), then SIGKILL after 2s if it's still alive
  kill $running 2>/dev/null || true
  sleep 2
  pgrep -f 'scripts/render.mjs' >/dev/null 2>&1 && kill -9 $running 2>/dev/null || true
  say "killed render (pid $running)"
fi

# Also kill any orphaned Chrome/Chromium spawned by Remotion (these can linger).
pkill -f 'chrome.*remotion' 2>/dev/null || true

# ── 2. Build delete list ────────────────────────────────────────────────────
paths=()
[[ -d cache ]]            && paths+=("cache")
[[ -d remotion/public ]]  && paths+=("remotion/public")
for d in novels/*/output novels/*/_work; do
  [[ -d "$d" ]] && paths+=("$d")
done

$LIBRARY && [[ -d library/visuals/backgrounds ]] && paths+=("library/visuals/backgrounds")
$MODELS  && [[ -d models ]]                       && paths+=("models")

if [[ ${#paths[@]} -eq 0 ]]; then
  say "nothing to clean"
  exit 0
fi

# ── 3. Show what we're about to nuke ────────────────────────────────────────
echo
say "will remove:"
for p in "${paths[@]}"; do
  size=$(du -sh "$p" 2>/dev/null | cut -f1)
  printf "  %-40s %s\n" "$p" "$size"
done
echo

if [[ "$YES" = false ]]; then
  read -rp "Proceed? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || { say "aborted"; exit 1; }
fi

# ── 4. Delete ──────────────────────────────────────────────────────────────
for p in "${paths[@]}"; do
  rm -rf "$p"
  echo "  removed $p"
done

# Recreate empty container dirs so the pipeline doesn't have to mkdir on next run
mkdir -p cache novels remotion/public

echo
say "done. Run [bold]./generate[/bold] to start fresh."
