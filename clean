#!/usr/bin/env bash
# ./clean — remove generated outputs and caches so you can start fresh.
#
# Removes (always):
#   cache/                  narration WAVs, image cache, remotion bundle
#   novels/<id>/output/     final MP4s, SRTs, chapter markers
#   novels/<id>/_work/      intermediate raw renders
#   remotion/public/        legacy empty folder, kept only for old checkouts
#
# Preserves (expensive to recreate / valuable content):
#   models/                       SDXL Turbo + diffusers weights (~6.5 GB)
#   .venv/                        Python venv
#   library/                      ALL user-curated assets — music, logo,
#                                 AND promoted backgrounds (real SDXL images
#                                 that took GPU time to generate). Never
#                                 touched by ./clean. Delete by hand if
#                                 you really need to.
#   in/                           your JSON spec(s)
#   manuscripts/, voices/, intro/, music/, cover/   your content
#
# Optional flags:
#   --models      also wipe models/ AND ~/.cache/huggingface/{hub,xet}
#                 (forces full redownload of every diffusion model — ~50+ GB
#                 if you've been collecting Animagine + Pony + FLUX + Z-Image)
#   --refs        also wipe library/visuals/characters/ (character reference
#                 images used by IP-Adapter). Otherwise refs are KEPT. Use this
#                 only when you want fresh face references for every character.
#   --yes, -y     skip confirmation prompt
#   -h, --help    show this help
#
# Usage:
#   ./clean              # standard clean
#   ./clean --models     # also reset SDXL weights
#   ./clean --yes        # skip prompt
# ----------------------------------------------------------------------------
set -euo pipefail
cd "$(dirname "$0")"

say()  { printf "\033[1;36m==>\033[0m %s\n" "$*" >&2; }
warn() { printf "\033[1;33m!\033[0m %s\n"   "$*" >&2; }
die()  { printf "\033[1;31mERROR:\033[0m %s\n" "$*" >&2; exit 1; }

MODELS=false
REFS=false
YES=false

for arg in "$@"; do
  case "$arg" in
    --models)    MODELS=true ;;
    --refs)      REFS=true ;;
    --yes|-y)    YES=true ;;
    -h|--help)
      # Print the header comment block: skip shebang, stop at the first non-# line.
      awk '/^#!/{next} !/^#/{exit} {sub(/^# ?/,""); print}' "$0"
      exit 0 ;;
    --library|--all)
      die "$arg removed for safety — library/ is never deleted by ./clean. " \
          "If you truly need to drop a background, delete it directly: " \
          "rm library/visuals/backgrounds/<name>.png" ;;
    *) die "unknown flag: $arg" ;;
  esac
done

# ── 1. Detect in-flight render and offer to kill ────────────────────────────
# Two things to look for:
#   (a) any stale legacy Remotion process
#   (b) any python ./novel render still running
render_pids=$(pgrep -f 'scripts/render.mjs|thai-novel render|novel render' 2>/dev/null || true)
chrome_pids=$(pgrep -f 'node_modules/.remotion/chrome-headless-shell' 2>/dev/null || true)
chrome_count=$(echo -n "$chrome_pids" | grep -c . || true)

if [[ -n "$render_pids" || $chrome_count -gt 0 ]]; then
  warn "pipeline processes detected:"
  [[ -n "$render_pids" ]] && echo "    render parent(s): $(echo $render_pids | tr '\n' ' ')" >&2
  [[ $chrome_count -gt 0 ]] && echo "    remotion chrome: $chrome_count process(es)" >&2

  if [[ "$YES" = false ]]; then
    read -rp "Kill all of them and proceed with clean? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { say "aborted; pipeline still running"; exit 1; }
  fi

  # SIGTERM first (graceful)
  [[ -n "$render_pids" ]] && kill $render_pids 2>/dev/null || true
  sleep 2
  # SIGKILL anything still alive, including orphaned Chrome subprocesses
  pkill -9 -f 'scripts/render.mjs|thai-novel render|novel render' 2>/dev/null || true
  pkill -9 -f 'node_modules/.remotion/chrome-headless-shell' 2>/dev/null || true
  sleep 1
  remaining=$(pgrep -f 'scripts/render.mjs|node_modules/.remotion/chrome-headless-shell' 2>/dev/null | wc -l | tr -d ' ')
  if [[ $remaining -gt 0 ]]; then
    warn "still $remaining process(es) alive after SIGKILL — check manually"
  else
    say "all pipeline processes terminated"
  fi
fi

# ── 2. Build delete list ────────────────────────────────────────────────────
paths=()
[[ -d cache ]]            && paths+=("cache")
[[ -d remotion/public ]]  && paths+=("remotion/public")
for d in novels/*/output novels/*/_work; do
  [[ -d "$d" ]] && paths+=("$d")
done

$MODELS  && [[ -d models ]]                       && paths+=("models")
# --models also wipes the HuggingFace default cache (~/.cache/huggingface/hub/).
# Some pipelines write outside our HF_HOME override; without this, "redownload"
# means redownloading by HF cache rules, which can miss what's already there.
$MODELS  && [[ -d "$HOME/.cache/huggingface/hub" ]] && paths+=("$HOME/.cache/huggingface/hub")
$MODELS  && [[ -d "$HOME/.cache/huggingface/xet" ]] && paths+=("$HOME/.cache/huggingface/xet")
# --refs only wipes character reference images. Other library subfolders
# (backgrounds, music, overlays, etc.) are NEVER touched by ./clean.
$REFS    && [[ -d library/visuals/characters ]] && paths+=("library/visuals/characters")

if [[ ${#paths[@]} -eq 0 ]]; then
  say "nothing to clean"
  exit 0
fi

# ── 3. Show what we're about to nuke ────────────────────────────────────────
echo
say "will remove:"
for p in "${paths[@]}"; do
  size=$(du -sh "$p" 2>/dev/null | cut -f1)
  printf "  %-40s %s\n" "$p" "$size"
done
echo

if [[ "$YES" = false ]]; then
  read -rp "Proceed? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || { say "aborted"; exit 1; }
fi

# ── 4. Delete ──────────────────────────────────────────────────────────────
for p in "${paths[@]}"; do
  rm -rf "$p"
  echo "  removed $p"
done

# Recreate empty container dirs so the pipeline doesn't have to mkdir on next run
mkdir -p cache novels remotion/public

echo
say "done. Run [bold]./generate[/bold] to start fresh."
