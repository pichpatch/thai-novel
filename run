#!/usr/bin/env bash
# ./run — one-time setup for the thai-novel pipeline.
#
# What it does:
#   1. Creates .venv/ with Python 3.13.
#   2. Installs requirements.txt (PyTorch + diffusers + PyThaiTTS + helpers).
#   3. Reminds you to drop CC0 instrumental tracks into music/.
#
# Model weights (~12 GB) are downloaded by HuggingFace on the FIRST image
# generation, not here — so this script is fast (a few minutes for pip).
#
# Idempotent — safe to re-run.

set -euo pipefail

cd "$(cd "$(dirname "$0")" && pwd)"

if ! command -v python3.13 >/dev/null 2>&1; then
  echo "❌ python3.13 not found. Install with: brew install python@3.13" >&2
  exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "❌ ffmpeg not found. Install with: brew install ffmpeg" >&2
  exit 1
fi

if [ ! -x .venv/bin/python ]; then
  echo "▸ Creating .venv with Python 3.13 ..."
  python3.13 -m venv .venv
fi
.venv/bin/pip install --upgrade pip >/dev/null
echo "▸ Installing requirements.txt (includes PyTorch — can take a few min) ..."
.venv/bin/pip install -r requirements.txt

if [ -z "$(ls -A music/*.mp3 music/*.m4a music/*.wav 2>/dev/null || true)" ]; then
  echo ""
  echo "ℹ️  music/ is empty. Drop a few CC0 instrumental tracks in there, or"
  echo "    run with --no-bgm. See music/README.md for free sources."
fi

echo ""
echo "✅ Setup complete. Next:"
echo "    ./make input.example.json"
echo ""
echo "    First image of the first render downloads ~12 GB of Z-Image-Turbo"
echo "    weights to ~/.cache/huggingface/ — that one is slow (~10 min on a"
echo "    fast connection). Every render after that reuses the cached weights."
