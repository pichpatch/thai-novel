# ─── Python ─────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
build/
dist/

# ─── Node / Remotion ────────────────────────────────────────────────────────
node_modules/
remotion/.cache/
.parcel-cache/
.next/

# ─── Caches (content-addressable; safe to delete anytime) ───────────────────
cache/

# ─── Model weights (auto-downloaded by `./novel doctor`) ────────────────────
models/

# ─── Per-episode outputs (gitignored — final.mp4 is regenerable) ────────────
novels/*/output/
novels/*/_work/

# ─── Legacy artifacts (still present at the project root) ───────────────────
out/

# ─── User-supplied media (kept locally, not committed; READMEs stay) ────────
music/*.mp3
music/*.m4a
music/*.wav
music/*.flac
music/*.ogg
!music/README.md

cover/*.png
cover/*.jpg
cover/*.jpeg
cover/*.webp
!cover/README.md
!cover/default.png

intro/_generated_*.*
intro/cache/

# ─── Library audio (loops, ambience) — large binaries kept local ────────────
library/audio/**/*.mp3
library/audio/**/*.wav
library/audio/**/*.ogg
library/audio/**/*.flac
!library/audio/**/_index.json

# ─── Voice models (Piper .onnx) — large, kept local ─────────────────────────
voices/*.onnx
!voices/*.json

# ─── Secrets / environment ──────────────────────────────────────────────────
.env
.env.local
.envrc

# ─── Editor / OS ────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

manuscripts/